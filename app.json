{
  "expo": {
    "name": "ELK Explorer",
    "slug": "elkApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "elkapp",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "backgroundColor": "#0F0F0F",
      "barStyle": "light-content"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keystoneelk.explorer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Your location is used to show your position on the Elk County map and help you navigate to trails, points of interest, and park features."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-adaptive.jpg",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.keystoneelk.explorer"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-sqlite",
      "expo-video",
      "./src/plugins/withCustomAndroidConfig.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be837c57-250c-4a1f-8446-422faf910cb2"
      }
    },
    "owner": "nixonmedias-team"
  }
}